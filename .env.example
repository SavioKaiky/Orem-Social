# Django
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081

# Banco de dados (o host "db" é o nome do serviço no docker-compose)
POSTGRES_DB=orem
POSTGRES_USER=orem
POSTGRES_PASSWORD=orem_dev_password
DATABASE_URL=postgres://orem:orem_dev_password@db:5432/orem

# PIX Banco do Brasil (o cliente fornece as credenciais depois)
BB_PIX_CLIENT_ID=
BB_PIX_CLIENT_SECRET=
BB_PIX_KEY=
BB_PIX_ENVIRONMENT=sandbox